---
// Sticky sollicitatieknop op mobiel (verschijnt na de hero, verdwijnt bij het formulier)
import { whatsappLink } from '@/data/site';
const wa = whatsappLink();
---

<div class="mobile-cta lg:hidden" data-mobile-cta>
  <a href="/solliciteren" class="flex-1 bg-gold-500 px-5 py-4 text-center text-xs font-semibold tracking-[0.18em] text-navy-900 uppercase">
    Solliciteer in 30 sec
  </a>
  {wa && (
    <a href={wa} target="_blank" rel="noopener" class="grid w-14 place-items-center bg-[#25D366] text-white" aria-label="Stuur ons een WhatsApp">
      <svg viewBox="0 0 24 24" class="size-6" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.7 11.7 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
    </a>
  )}
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mobile-cta]');
  if (bar) {
    const form = document.querySelector('#solliciteer');
    let pastHero = false;
    let formVisible = false;
    const update = () => bar.classList.toggle('is-visible', pastHero && !formVisible);
    window.addEventListener('scroll', () => { pastHero = window.scrollY > window.innerHeight * 0.6; update(); }, { passive: true });
    if (form) {
      new IntersectionObserver(([e]) => { formVisible = e.isIntersecting; update(); }).observe(form);
    }
  }
</script>

<style>
  .mobile-cta {
    position: fixed;
    left: 12px; right: 12px;
    bottom: calc(12px + env(safe-area-inset-bottom));
    z-index: 40;
    display: flex;
    box-shadow: 0 12px 40px -10px rgb(4 14 28 / 0.5);
    transform: translateY(calc(100% + 30px));
    transition: transform 0.6s var(--ease-out-expo);
  }
  .mobile-cta.is-visible { transform: none; }
</style>
