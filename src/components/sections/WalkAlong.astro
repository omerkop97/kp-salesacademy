---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';

const points = [
  'Helemaal vrijblijvend, je zit nergens aan vast',
  'Je loopt mee met een ervaren collega',
  'Je proeft de sfeer in het team',
  'Daarna beslis je zelf of het bij je past',
];
---

<section id="meelopen" class="bg-ivory-100 py-28 lg:py-36">
  <div class="container-x grid gap-14 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:gap-24">
    <div>
      <SectionHeading eyebrow="Je eerste stap">
        Begin met een<br /><em>meeloopdag</em>
        <Fragment slot="intro">
          Bij ons begint iedereen met een vrijblijvende meeloopdag. Zo ervaar je zelf hoe het is om bij K&amp;P Sales Academy te werken, voordat je iets beslist.
        </Fragment>
      </SectionHeading>
      <div class="mt-10" data-reveal="up">
        <Button href="/solliciteren" variant="navy">Plan je meeloopdag</Button>
      </div>
    </div>

    <ul class="border-t border-navy-800/15" data-stagger>
      {points.map((point) => (
        <li class="flex items-center gap-5 border-b border-navy-800/15 py-6 text-lg text-navy-800">
          <span class="size-2 shrink-0 rotate-45 bg-gold-500" aria-hidden="true"></span>
          {point}
        </li>
      ))}
    </ul>
  </div>
</section>
