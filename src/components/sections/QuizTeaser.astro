---
import Button from '@/components/ui/Button.astro';
---

<section class="quiz-teaser relative overflow-hidden bg-gold-500 py-20 text-navy-900 lg:py-28">
  <div class="teaser-pattern pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="container-x relative flex flex-col items-start gap-10 lg:flex-row lg:items-center lg:justify-between">
    <div>
      <p class="eyebrow mb-5 flex items-center gap-4" data-reveal="fade">
        <span class="h-px w-10 bg-current"></span>60 seconden · 5 vragen
      </p>
      <h2 class="h-section text-navy-900" data-split>
        Past sales<br /><em class="text-navy-900!">bij jou?</em>
      </h2>
      <p class="mt-6 max-w-md text-lg leading-relaxed text-navy-900/80" data-reveal="up">
        Doe de test en ontdek welk salestype jij bent. Geen goede of foute antwoorden.
      </p>
    </div>
    <div data-reveal="up">
      <Button href="/solliciteren" variant="navy" data-quiz-open>Start de test</Button>
    </div>
  </div>
</section>

<style>
  .teaser-pattern {
    opacity: 0.12;
    background-image: linear-gradient(45deg, var(--color-navy-900) 1px, transparent 1px),
      linear-gradient(-45deg, var(--color-navy-900) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(90deg, transparent 30%, #000);
  }
</style>
