---
import ApplyForm from '@/components/forms/ApplyForm.astro';
import GoldDivider from '@/components/ui/GoldDivider.astro';
import { whatsappLink } from '@/data/site';
const wa = whatsappLink();
---

<section id="solliciteer" class="grain on-dark relative overflow-hidden bg-navy-900 py-28 text-ivory-50/75 lg:py-40">
  <div class="apply-glow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="container-x grid gap-16 lg:grid-cols-[1fr_1fr] lg:gap-24">
    <div>
      <p class="eyebrow mb-6 flex items-center gap-4 text-gold-300" data-reveal="fade">
        <span class="h-px w-10 bg-current"></span>Join de Academy
      </p>
      <h2 class="h-section" data-split>
        Klaar voor<br />de <em>volgende stap?</em>
      </h2>
      <p class="mt-8 max-w-md text-lg leading-relaxed" data-reveal="up">
        Laat je gegevens achter. Het kost je 30 seconden, wij doen de rest. Je zit nergens aan vast: je loopt eerst gewoon een dag mee.
      </p>

      <ul class="mt-10 space-y-4" data-stagger>
        {['Reactie binnen 24 uur', 'Eerst een vrijblijvende meeloopdag', 'Geen ervaring of cv nodig'].map((item) => (
          <li class="flex items-center gap-4 text-ivory-50">
            <span class="size-2 rotate-45 bg-gold-500"></span>{item}
          </li>
        ))}
      </ul>

      {wa && (
        <div class="mt-12" data-reveal="up">
          <GoldDivider class="mb-8 max-w-md" />
          <p class="mb-4">Liever direct contact?</p>
          <a href={wa} target="_blank" rel="noopener" class="inline-flex items-center gap-3 border border-[#25D366]/60 px-5 py-3 text-sm font-medium text-ivory-50 transition hover:bg-[#25D366] hover:text-navy-900">
            <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm4.5 12.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.7 11.7 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
            Stuur ons een WhatsApp
          </a>
        </div>
      )}
    </div>

    <div class="relative border border-ivory-50/12 bg-navy-950/40 p-7 backdrop-blur-sm sm:p-12" data-reveal="up">
      <span class="absolute -top-px left-10 h-px w-24 bg-gold-500" aria-hidden="true"></span>
      <ApplyForm />
    </div>
  </div>
</section>

<style>
  .apply-glow {
    background:
      radial-gradient(50% 60% at 80% 40%, rgb(201 161 59 / 0.1), transparent 70%),
      radial-gradient(40% 50% at 0% 100%, rgb(30 58 95 / 0.6), transparent 70%);
  }
</style>
