---
// Quiz "Past sales bij jou?" in een dialoog. Openen met elk element met [data-quiz-open].
import ApplyForm from '@/components/forms/ApplyForm.astro';
import Logo from '@/components/ui/Logo.astro';
import { quizQuestions, quizProfiles } from '@/data/content';
---

<dialog class="quiz grain" data-quiz data-lenis-prevent aria-labelledby="quiz-title">
  <div class="quiz__inner">
    <header class="flex items-center justify-between gap-4">
      <Logo tone="light" tagline={false} />
      <button type="button" class="quiz__close" data-quiz-close aria-label="Quiz sluiten">
        <span></span><span></span>
      </button>
    </header>

    <div class="quiz__progress mt-8" aria-hidden="true"><span data-quiz-bar></span></div>
    <p class="eyebrow mt-4 text-gold-300" id="quiz-title">
      Past sales bij jou? · <span data-quiz-count>1</span>/{quizQuestions.length}
    </p>

    <div class="quiz__stage">
      {quizQuestions.map((question, i) => (
        <section class="quiz__step" data-quiz-step={i} hidden={i !== 0}>
          <h2 class="quiz__q">{question.q}</h2>
          <div class="mt-8 grid gap-3">
            {question.answers.map((a) => (
              <button
                type="button"
                class="quiz__answer"
                data-quiz-answer
                data-profile={a.profile}
                data-value={a.value}
              >
                <span class="quiz__dot" aria-hidden="true"></span>
                {a.label}
              </button>
            ))}
          </div>
        </section>
      ))}

      <section class="quiz__step" data-quiz-result hidden>
        <p class="eyebrow text-gold-300">Jouw uitslag</p>
        <h2 class="quiz__q mt-3">Jij bent <em data-quiz-profile-title></em></h2>
        <p class="mt-4 max-w-lg text-lg leading-relaxed text-ivory-50/75" data-quiz-profile-text></p>
        <p class="mt-4 text-ivory-50">Sales past bij jou. Kom een dag vrijblijvend meelopen?</p>
        <div class="mt-8 border border-ivory-50/12 bg-navy-950/40 p-6 sm:p-8">
          <ApplyForm />
        </div>
      </section>
    </div>
  </div>
</dialog>

<script is:inline type="application/json" data-quiz-profiles set:html={JSON.stringify(quizProfiles)} />

<script>
  import gsap from 'gsap';
  import { track } from '@/lib/tracking';

  const dialog = document.querySelector<HTMLDialogElement>('[data-quiz]');
  if (dialog) {
    const profiles = JSON.parse(document.querySelector('[data-quiz-profiles]')!.textContent!);
    const steps = [...dialog.querySelectorAll<HTMLElement>('[data-quiz-step]')];
    const result = dialog.querySelector<HTMLElement>('[data-quiz-result]')!;
    const bar = dialog.querySelector<HTMLElement>('[data-quiz-bar]')!;
    const count = dialog.querySelector<HTMLElement>('[data-quiz-count]')!;
    const form = result.querySelector<HTMLFormElement>('form')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let index = 0;
    let scores: Record<string, number> = {};
    let start = '';

    const show = (el: HTMLElement, from?: HTMLElement) => {
      if (from) from.hidden = true;
      el.hidden = false;
      if (!reduced) gsap.fromTo(el.children, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.6, stagger: 0.06, ease: 'expo.out' });
      el.querySelector<HTMLElement>('button, input')?.focus({ preventScroll: true });
    };

    const progress = () => {
      const total = steps.length;
      bar.style.transform = `scaleX(${Math.min(index, total) / total})`;
      count.textContent = String(Math.min(index + 1, total));
    };

    const reset = () => {
      index = 0;
      scores = {};
      start = '';
      steps.forEach((s, i) => (s.hidden = i !== 0));
      result.hidden = true;
      progress();
    };

    const open = () => {
      reset();
      dialog.showModal();
      document.documentElement.classList.add('lenis-stopped');
      show(steps[0]);
      track('quiz_start');
    };
    const close = () => {
      dialog.close();
    };
    dialog.addEventListener('close', () => document.documentElement.classList.remove('lenis-stopped'));
    // klik op de achtergrond sluit
    dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); });
    dialog.querySelector('[data-quiz-close]')!.addEventListener('click', close);
    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest('[data-quiz-open]');
      if (!trigger) return;
      e.preventDefault();
      open();
    });

    dialog.querySelectorAll<HTMLButtonElement>('[data-quiz-answer]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const { profile, value } = btn.dataset;
        if (profile) scores[profile] = (scores[profile] ?? 0) + 1;
        if (value) start = value;
        btn.classList.add('is-picked');

        const current = steps[index];
        index++;
        progress();
        setTimeout(() => {
          btn.classList.remove('is-picked');
          if (index < steps.length) return show(steps[index], current);

          // uitslag: profiel met de hoogste score (bij gelijkspel het eerst gekozen)
          const winner = Object.entries(scores).sort((a, b) => b[1] - a[1])[0]?.[0] ?? 'verbinder';
          const p = profiles[winner];
          result.querySelector('[data-quiz-profile-title]')!.textContent = p.title;
          result.querySelector('[data-quiz-profile-text]')!.textContent = p.text;
          (form.elements.namedItem('quiz_profiel') as HTMLInputElement).value = p.title;
          (form.elements.namedItem('startmoment') as HTMLInputElement).value = start;
          count.textContent = String(steps.length);
          show(result, current);
          track('quiz_complete', { profiel: p.title });
        }, reduced ? 0 : 280);
      });
    });
  }
</script>

<style>
  .quiz {
    width: min(42rem, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    color: var(--color-ivory-50);
    background: var(--color-navy-900);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .quiz[open] { animation: quiz-in 0.6s var(--ease-out-expo); }
  .quiz::backdrop {
    background: rgb(4 14 28 / 0.7);
    backdrop-filter: blur(4px);
    animation: fade 0.4s ease;
  }
  @keyframes quiz-in { from { transform: translateX(100%); } }
  @keyframes fade { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .quiz[open], .quiz::backdrop { animation: none; }
  }

  .quiz__inner {
    min-height: 100%;
    padding: 1.5rem 1.25rem 3rem;
  }
  @media (min-width: 640px) { .quiz__inner { padding: 2.25rem 3rem 4rem; } }

  .quiz__close { position: relative; width: 2.75rem; height: 2.75rem; }
  .quiz__close span {
    position: absolute; left: 50%; top: 50%; width: 22px; height: 1.5px; background: currentColor;
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .quiz__close span + span { transform: translate(-50%, -50%) rotate(-45deg); }

  .quiz__progress { height: 2px; background: rgb(250 248 243 / 0.12); overflow: hidden; }
  .quiz__progress span {
    display: block; height: 100%; background: var(--color-gold-500);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.6s var(--ease-out-expo);
  }

  .quiz__stage { margin-top: 2.5rem; }
  .quiz__q {
    font-size: clamp(2rem, 6vw, 2.9rem);
    color: var(--color-ivory-50);
  }
  .quiz__q em { color: var(--color-gold-300); }

  .quiz__answer {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 1.1rem 1.25rem;
    text-align: left;
    font-size: 1.05rem;
    color: var(--color-ivory-50);
    border: 1px solid rgb(250 248 243 / 0.18);
    transition: border-color 0.3s, background-color 0.3s, transform 0.3s var(--ease-out-expo);
  }
  .quiz__answer:hover { border-color: var(--color-gold-500); transform: translateX(4px); }
  .quiz__answer.is-picked { background: var(--color-gold-500); border-color: var(--color-gold-500); color: var(--color-navy-900); }
  .quiz__dot {
    width: 0.55rem; height: 0.55rem; flex-shrink: 0;
    border: 1px solid var(--color-gold-500);
    transform: rotate(45deg);
    transition: background-color 0.3s;
  }
  .quiz__answer:hover .quiz__dot, .quiz__answer.is-picked .quiz__dot { background: currentColor; border-color: currentColor; }
</style>
