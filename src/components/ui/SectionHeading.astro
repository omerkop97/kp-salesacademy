---
interface Props {
  eyebrow: string;
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, align = 'left', class: className = '' } = Astro.props;
---

<div class:list={[align === 'center' ? 'mx-auto text-center' : '', 'max-w-4xl', className]}>
  <p
    class:list={['eyebrow mb-6 flex items-center gap-4 text-gold-500', align === 'center' && 'justify-center']}
    data-reveal="fade"
  >
    <span class="h-px w-10 bg-current"></span>
    {eyebrow}
    {align === 'center' && <span class="h-px w-10 bg-current"></span>}
  </p>
  <h2 class="h-section" data-split>
    <slot />
  </h2>
  {Astro.slots.has('intro') && (
    <p class:list={['mt-7 max-w-2xl text-lg leading-relaxed', align === 'center' && 'mx-auto']} data-reveal="up">
      <slot name="intro" />
    </p>
  )}
</div>
