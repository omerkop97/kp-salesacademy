---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import GoldDivider from '@/components/ui/GoldDivider.astro';
import { site } from '@/data/site';
---

<BaseLayout title="Bedankt" noindex showMobileCta={false}>
  <section class="grain on-dark flex min-h-svh items-center bg-navy-900 py-32 text-center text-ivory-50/75">
    <div class="container-x max-w-3xl">
      <p class="eyebrow mb-6 text-gold-300" data-reveal="fade" data-thanks-eyebrow>Meeloopdag aangevraagd</p>
      <h1 class="h-section text-ivory-50" data-split>
        Top<span data-name></span>, <em>je bent er bijna!</em>
      </h1>
      <p class="mx-auto mt-8 max-w-lg text-lg leading-relaxed" data-reveal="up" data-thanks-text>
        We bellen of appen je binnen 24 uur om samen een dag te plannen waarop je vrijblijvend meeloopt. Houd je telefoon in de gaten!
      </p>
      <GoldDivider class="mx-auto my-12 max-w-xs" />
      <div class="flex flex-col items-center justify-center gap-3 sm:flex-row" data-reveal="up">
        {site.whatsapp && (
          <a
            href={`https://wa.me/${site.whatsapp}`}
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-13 items-center gap-3 bg-[#25D366] px-6 text-xs font-semibold tracking-[0.18em] text-navy-900 uppercase"
            data-wa
          >
            Stuur ons alvast een WhatsApp
          </a>
        )}
        <Button href="/" variant="ghost-light">Terug naar home</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { track } from '@/lib/tracking';
  import { getVariant } from '@/lib/ab';

  const params = new URLSearchParams(location.search);
  const name = params.get('naam')?.slice(0, 40);

  const slot = document.querySelector('[data-name]');
  if (name && slot) slot.textContent = ` ${name}`;

  const wa = document.querySelector<HTMLAnchorElement>('[data-wa]');
  if (wa) {
    const who = name ? `Ik ben ${name} en ik` : 'Ik';
    const msg = `Hoi! ${who} heb me net aangemeld voor een meeloopdag. Ik heb er zin in!`;
    wa.href += `?text=${encodeURIComponent(msg)}`;
  }

  // lead meten, alleen na een echte inzending (niet bij herladen of direct bezoek)
  try {
    const lead = sessionStorage.getItem('kp_lead');
    if (lead) {
      sessionStorage.removeItem('kp_lead');
      track('lead', { type: lead, ab_variant: getVariant() });
    }
  } catch { /* */ }
</script>
